<Page x:Class="PR17.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock Text="Личный кабинет" FontSize="22" FontWeight="Bold"/>

            <TextBlock x:Name="UserInfo" Margin="0,10,0,10"/>

            <TextBlock Text="Мои записи" FontSize="16"/>
            <ListBox x:Name="AppointmentsList" Height="150"/>

            <TextBlock Text="Мои заказы" FontSize="16" Margin="0,10,0,0"/>
            <ListBox x:Name="OrdersList" Height="150"/>

            <Button Content="Назад" Click="Back_Click" Margin="0,10,0,0"/>

        </StackPanel>

    </Grid>
</Page>