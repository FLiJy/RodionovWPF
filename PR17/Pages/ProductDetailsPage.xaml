<Page x:Class="PR17.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold"/>

            <TextBlock x:Name="PriceText" FontSize="16"/>
            <TextBlock x:Name="DiscountText" FontSize="16"/>
            <TextBlock x:Name="RatingText" FontSize="16"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap"/>

            <Button Content="Добавить в корзину" Click="AddToCart_Click"/>
            <Button Content="Назад" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>