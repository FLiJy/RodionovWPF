<Page x:Class="PR17.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Записи" Click="ShowAppointments"/>
                <Button Content="Заказы" Click="ShowOrders"/>
                <Button Content="Товары" Click="ShowProducts"/>
            </StackPanel>

            <ListBox x:Name="MainList" Height="300"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Удалить" Click="Delete_Click"/>
                <Button Content="Обновить" Click="Refresh_Click"/>
            </StackPanel>

            <Button Content="Назад" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>