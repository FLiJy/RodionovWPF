<Page x:Class="PR17.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1E1E1E">

        <Border Width="350"
                Padding="20"
                Background="#2D2D2D"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="22"
                           Foreground="White"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО" Foreground="White"/>
                <TextBox x:Name="FullNameBox"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" Foreground="White"/>
                <TextBox x:Name="PhoneBox"/>

                <!-- Логин -->
                <TextBlock Text="Логин" Foreground="White"/>
                <TextBox x:Name="LoginBox"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="White"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Button Content="Создать аккаунт"
                        Margin="0,10,0,0"
                        Click="Register_Click"/>

                <Button Content="Назад"
                        Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>