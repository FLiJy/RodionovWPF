<Page x:Class="PR17.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel>

            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>

            <WrapPanel x:Name="ProductsPanel"/>

            <Button Content="Корзина" Click="Cart_Click"/>
            <Button Content="Назад" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>