<Page x:Class="PR17.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#121212">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="320">

            <TextBlock Text="Космическая ложа"
                       FontSize="26"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- 🔥 УСЛУГИ -->
            <TextBlock Text="Услуги"
                       Foreground="White"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="ServicesList"
                     Height="120"
                     DisplayMemberPath="Name"
                     Margin="0,0,0,10"/>

            <Button Content="Войти"
                    Click="Login_Click"/>

            <Button Content="Регистрация"
                    Click="Register_Click"/>

            <Button Content="Товары"
                    Click="Products_Click"/>

            <Button Content="Записаться"
                    Click="GoAppointment_Click"/>

        </StackPanel>

    </Grid>
</Page>