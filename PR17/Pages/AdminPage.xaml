<Page x:Class="PR17.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel>

            <TextBlock Text="Пользователи" FontSize="20"/>

            <ListBox x:Name="UsersList" Height="300"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Click="Add_Click"/>
                <Button Content="Изменить роль" Click="Role_Click"/>
                <Button Content="Заморозить / Разморозить" Click="Block_Click"/>
            </StackPanel>

            <Button Content="Обновить" Click="Refresh_Click"/>
            <Button Content="Назад" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>