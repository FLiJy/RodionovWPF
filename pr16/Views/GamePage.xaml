<Page x:Class="pr16.Views.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="2"  Margin="10">
            <StackPanel VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Этаж: " FontSize="18"/>
                    <TextBlock x:Name="TurnText" FontSize="18"/>
                </StackPanel>

                <TextBlock Text="Здоровье игрока" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar x:Name="PlayerHP"
                 Width="200"
                 Height="20"
                 Margin="5"/>
                    <TextBlock x:Name="PlayerHPText"
               VerticalAlignment="Center"
               Margin="5,0"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2"  Margin="10">
            <Grid>

                <StackPanel x:Name="BattlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="EnemyImage"
                       Width="120"
                       Height="120"
                       Margin="0,0,0,10"/>      

                    <TextBlock x:Name="EnemyText" FontSize="32" Margin="0,0,0,10" HorizontalAlignment="Center" TextAlignment="Center"  />

                    <TextBlock Text="Здоровье врага" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ProgressBar x:Name="EnemyHP"
                 Width="200"
                 Height="20"
                 Margin="5"/>
                        <TextBlock x:Name="EnemyHPText"
               VerticalAlignment="Center"
               Margin="5,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Атака" Width="110" Margin="10" Click="Attack_Click"/>
                        <Button Content="Защита" Width="110" Margin="10" Click="Defend_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ItemPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Найден предмет!"
                               FontSize="28"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="ItemName" FontSize="22"/>
                    <TextBlock x:Name="ItemStats" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Взять" Width="110" Margin="5" Click="Take_Click"/>
                        <Button Content="Не брать" Width="110" Margin="5" Click="Skip_Click"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Black" BorderThickness="2"  Margin="10">
                <StackPanel Margin="10">
                    <TextBlock Text="Инвентарь" FontSize="20"/>
                    <TextBlock x:Name="WeaponText"/>
                    <TextBlock x:Name="ArmorText"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2"  Margin="10">
                <ListBox x:Name="LogBox" />
            </Border>
        </Grid>
    </Grid>
</Page>